# Copy to .env and fill in. .env is in .gitignore and must never be committed.
LLM_PROVIDER=anthropic          # anthropic | gemini | ollama
LLM_MODEL=claude-sonnet-5-5     # gemini: gemini-3.8-flash or gemini-3.5-flash-lite; ollama: qwen2.5:7b-instruct
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
MOCK_LLM=true                   # true = rules and templates, no model calls
API_URL=http://localhost:8000
ADMIN_TOKEN=                    # if set, POST /ingest requires header X-Admin-Token
# DB_PATH is optional: leave it out to use allocator.db in this folder. An empty DB_PATH= gives a throwaway database.
